# A .pubignore replaces .gitignore entirely for publishing, so build output has
# to be listed here as well as there.

# Build and tool output
build/
.dart_tool/
coverage/
example/build/
example/.dart_tool/

# Repository-only material
.github/
doc/raw/
doc/originals/
*.iml
.idea/

# Platform scaffolding for the example app; the example ships as source only.
example/android/
example/ios/
example/web/
example/linux/
example/macos/
example/windows/
example/test/

# Supplied mockups, kept in the repository for reference. They do not depict
# this package and nothing links to them, so they should not weigh down every
# download. The generated screenshots in doc/images/ do ship: pub.dev requires
# the files named by the screenshots: block to be inside the archive.
doc/images/interactive-demo.png
doc/images/interactive-demo-2.png
doc/images/overflow-before-original.png
